# Shared — copy to .env in each service and fill in values
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set by Person 1 after running: python cache_loader.py
CACHE_NAME=

# Backend (Person 1) — port 8000
PORT=8000

# Live Service (Person 2) — port 8001
# PORT=8001

# Frontend (Person 3)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_LIVE_URL=ws://localhost:8001
